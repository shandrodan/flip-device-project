# Copy to .env (repo root). Everything is optional: with nothing set, agents use the built-in
# planner, speech uses the Device's own recognition, and the PC agent is this computer.

# --- Server ---
# PORT=8787
# PUBLIC_URL=http://100.101.102.103:8787   # what the Device shows for the setup page
# SETUP_TOKEN=                              # protect /setup with ?token=...
# HOSTING=self                              # cloud | vm | self (Full mode is off on "cloud")

# --- AI (bring your own key) --- also settable on http://<server>:8787/setup
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-5-5
# SUGGEST_MODEL=claude-opus-5-5

# --- Speech to text (any OpenAI-compatible /audio/transcriptions endpoint) ---
# STT_API_KEY=
# STT_URL=https://api.openai.com/v1/audio/transcriptions
# STT_MODEL=whisper-1
# LOCAL_STT_URL=http://127.0.0.1:8000/v1/audio/transcriptions   # whisper.cpp / faster-whisper, used offline

# --- Machines with a PC agent (Tailscale addresses) ---
# PC_AGENTS=MacBook Pro=ws://100.101.102.103:7077,Studio PC=ws://100.101.102.104:7077
# PC_AGENT_TOKEN=change-me                 # same value on every PC agent

# --- Build app (ADR 0021): the project folder on the PC agent's machine, and the preview the Device loads ---
# BUILD_DIR=~/Flip/build
# BUILD_NAME=Flip Device
# BUILD_PREVIEW_URL=http://100.101.102.103:5173

# --- Mail. Without SMTP, "send" writes an .eml to ~/Flip/Outbox and opens it in your mail app ---
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=you@example.com
# CONTACTS=Jonas=jonas@example.com,Marta=marta@example.com
